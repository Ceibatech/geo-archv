# Base MySQL distante accessible depuis Vercel.
# Ajoutez ?ssl=true lorsque le fournisseur impose TLS.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl=true"

# Secret serveur aléatoire d'au moins 32 caractères. Ne jamais le préfixer par NEXT_PUBLIC_.
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Clé serveur Resend et expéditeur appartenant à un domaine vérifié.
RESEND_API_KEY="re_replace_with_your_api_key"
RESEND_FROM_EMAIL="Archives CG1020 <rapports@votre-domaine.com>"

# URL canonique sans slash final. En local : http://localhost:3000
APP_URL="https://votre-projet.vercel.app"
